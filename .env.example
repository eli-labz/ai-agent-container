# AI Agent Container application
AI_AGENT_CONTAINER_ENV=development
AI_AGENT_CONTAINER_HOST=0.0.0.0
AI_AGENT_CONTAINER_PORT=5000
# Preserve the existing SQLite store by default. Set a SQLAlchemy URL to override.
# AI_AGENT_CONTAINER_DATABASE_URL=sqlite:///data/flowcase.db

# Security
# Leave blank to generate a local key in data/secret_key. Use a strong random value in deployment.
SECRET_KEY=

# Docker runtime
# Leave unset to use the Docker SDK defaults (including the local Docker socket).
# DOCKER_HOST=unix:///var/run/docker.sock

# Optional model provider credentials. Not consumed or forwarded to Agent runtimes yet.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Reverse proxy and optional Authentik integration
DOMAIN=localhost
ADMIN_EMAIL=admin@example.com
CA_SERVER=https://acme-staging-v02.api.letsencrypt.org/directory
PG_PASS=replace-with-a-random-database-password
AUTHENTIK_SECRET_KEY=replace-with-a-random-authentik-secret
# PG_USER=authentik
# PG_DB=authentik
# AUTHENTIK_IMAGE=ghcr.io/goauthentik/server
# AUTHENTIK_TAG=2025.6.4

# Logging
LOG_LEVEL=INFO
